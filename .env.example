# Host environment only. Do not put real values in this file or in git.
# Account, RPC, and data-provider credentials belong in the deployment
# dashboard. Leave a variable empty to keep that adapter disabled.

# https origin of mt-auth. http is accepted only for localhost.
AUTH_TARGET_URL=

# https origin of mt-core. http is accepted only for localhost.
MT_TARGET_URL=

# Server-side Solana JSON-RPC URL. Leave empty to disable Solana reads.
SOLANA_RPC_URL=

# Server-side Moralis key. Leave empty to disable the Moralis adapter.
MORALIS_API_KEY=

# Sign-in stays locked unless the matching flag is explicitly off.
# Set both to off only when the vault should accept sign-in again.
SIGNIN_LOCK=
VITE_SIGNIN_LOCK=
